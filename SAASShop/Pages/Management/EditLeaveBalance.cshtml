@page "{Id}"
@model SAASShop.Pages.Management.EditLeaveBalanceModel
@{
    ViewData["Title"] = "Edit Leave Balance";
}
@section SideMenu {
    @{
        await Html.RenderPartialAsync("_DashboardMenuPartial", new MenuModel { Identifier = "leavemanage" });
    }
}
<partial name="_DataFormTitlePartial" model='new string("Edit Leave Balance")' />
<div class="card dataForm">
    <form method="Post">
        <partial name="_LeaveBalancePartial" model="Model.leaveBalance" />

        <div class="rowborder-top p-2">
            <div class="col-md-12 text-right">
                <hr />
                <button type="submit" class="btn btn-blueTwo ms-2 float-end">  Save </button>
                <a href="@Navigator.LeaveManage" class="btn btn-sliverOne float-end">Cancel</a>
            </div>
        </div>
    </form>
</div>