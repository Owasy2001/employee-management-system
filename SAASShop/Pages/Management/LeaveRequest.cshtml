@page
@model SAASShop.Pages.Management.LeaveRequestModel
@{
	ViewData["Title"] = "Leave Request";
}
@section SideMenu {
    @{
        await Html.RenderPartialAsync("_DashboardMenuPartial", new MenuModel { Identifier = "leavereq" });
    }
}

@if (TempData["Message"] != null)
{
    <partial name="_MessagePartial" model='new MessageModel { Message = TempData["Message"] }' />
}

<partial name="_DataFormTitlePartial" model='new string("Leave Request")' />
<div class="card">

 <div class="mt-2">
        <a href="@Navigator.AddLeave" class="btn btn-sm btn-greenOne">Add leave</a>
 </div>
    <div class="row">
        <div class="col">
            <table class="table table-striped table-bordered table-hover">
                <thead class="thead-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Department</th>
                        <th scope="col">Leave Type </th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>

                     @foreach (var user in Model.Userleave)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@user.Phone</td>
                            <td>@user.LeaveType </td>
                            

                            <td>
                                <a href="@Navigator.EditLeave/@user.Id" class="btn btn-xs btn-greenTwo">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
