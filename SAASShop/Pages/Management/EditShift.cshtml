@page "{Id}"
@model SAASShop.Pages.Management.EditShiftModel
@{
    ViewData["Title"] = "Edit Shift Data";
}
@* @section SideMenu {
    @{
        await Html.RenderPartialAsync("_DashboardMenuPartial", new MenuModel { Identifier = "shift" });
    }
} *@
<partial name="_DataFormTitlePartial" model='new string("Edit Shift Data")' />
<div class="card dataForm">
    <form method="Post">
        <partial name="_ShiftPartial" model="Model.ShiftData" />

            <div class="rowborder-top p-2">
                <div class="col-md-12 text-right">
                    <hr />
                    <button type="submit" class="btn btn-blueTwo ms-2 float-end">  Save </button>
                    <a href="@Navigator.ShiftManage" class="btn btn-sliverOne float-end">Cancel</a>
                </div>
            </div>
    </form>
</div>