@page "{Id}"
@model SAASShop.Pages.Management.EditOvertimeModel
@{
    ViewData["Title"] = "Edit Overtime Data";
}
@section SideMenu {
    @{
        await Html.RenderPartialAsync("_DashboardMenuPartial", new MenuModel { Identifier = "overtime" });
    }
}
<partial name="_DataFormTitlePartial" model='new string("Edit Overtime Data")' />
<div class="card dataForm">
    <form method="Post">
        <partial name="_OvertimePartial" model="Model.OvertimeData" />

        <div class="rowborder-top p-2">
            <div class="col-md-12 text-right">
                <hr />
                <button type="submit" class="btn btn-blueTwo ms-2 float-end">  Save </button>
                <a href="@Navigator.OvertimeManage" class="btn btn-sliverOne float-end">Cancel</a>
            </div>
        </div>
    </form>
</div>