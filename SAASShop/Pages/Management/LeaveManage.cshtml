@page
@using SAASShopDomain
@model SAASShop.Pages.Management.LeaveManageModel

@{
    ViewData["Title"] = "Leave Manage";
    ViewData["ShowApproval"] = true;
}
@section SideMenu {
    @{
        await Html.RenderPartialAsync("_DashboardMenuPartial", new MenuModel { Identifier = "leave" });
    }
}

@if (TempData["Message"] != null)
{
    <partial name="_MessagePartial" model='new MessageModel { Message = TempData["Message"] }' />
}

<partial name="_DataFormTitlePartial" model='new string("Leave Management")' />

<div class="card">

 <div class="mt-2">
        <a href="@Navigator.AddLeaveBalance" class="btn btn-sm btn-greenOne">Add User</a>
 </div>
    <div class="row">
        <div class="col">
            <table class="table table-striped table-bordered table-hover">
                <thead class="thead-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Leave Type</th>
                        <th>Approval</th>
                        <th>Leave Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Userleave)
                    {
                        var balance = Model.UserLeaveBalances.FirstOrDefault(b => b.AppUserId == user.AppUserId);
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@user.Phone</td>
                            <td>@user.LeaveType</td>
                            <td>
                                <form method="post" asp-page-handler="Show">
                                    <input type="hidden" name="listId" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary">Show</button>
                                </form>
                                @* <form method="post" asp-page-handler="Approve" class="mt-1"> *@
                                @*     <input type="hidden" name="leaveId" value="@user.Id" /> *@
                                @*     <button type="submit" class="btn btn-sm btn-success">Approve</button> *@
                                @* </form> *@
                            </td>
                            <td>
                                @if (balance != null)
                                {
                                    <a href="@Navigator.EditLeaveBalance/@balance.Id" class="btn btn-xs btn-greenTwo">Edit</a>
                                }
                                else
                                {
                                    <span class="text-muted">No Leave Balance</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.IsShow && Model.LeaveData != null)
{
    <script>
        $(document).ready(function () {
            $('#approveModal').modal('show');
        });
    </script>

    <div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form method="post" asp-page-handler="Approve">
                    <div class="modal-header">
                        <h5 class="modal-title" id="approveModalLabel">Approve Leave Request</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" name="leaveId" value="@Model.LeaveData.Id" />
                        <partial name="_LeavePartial" model="Model.LeaveData" view-data="ViewData" />
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-blueTwo">Approve Leave</button>
                        <a href="@Navigator.LeaveRequest" class="btn btn-sliverOne">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
