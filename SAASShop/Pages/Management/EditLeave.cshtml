@page "{Id}"
@model SAASShop.Pages.Management.EditLeaveModel
@{
	ViewData["Title"] = "Edit Leave User";
    ViewData["ShowApproval"] = false;
}
@section SideMenu {
    @{
        await Html.RenderPartialAsync("_DashboardMenuPartial", new MenuModel { Identifier = "leave" });
    }
}
 <partial name="_DataFormTitlePartial" model='new string("Edit Leave Users")' /> 
@* @{
    var userName = User.Claims.FirstOrDefault(x => x.Type == System.Security.Claims.ClaimTypes.GivenName).Value;
}
<partial name="_DataFormTitlePartial" model='new string($"Edit Leave Application for {userName}")' /> *@

@if (HttpContext.Request.Query["IsShow"] == "true")
{
    <form method="post" asp-page-handler="Show">
        <input type="hidden" name="listId" value="@Model.LeaveData.Id" />
    </form>
}

<div class="card dataForm">
    <form method="Post">

        <partial name="_LeavePartial" model="Model.LeaveData" view-sata="ViewData" />
        @if (HttpContext.Request.Query["IsShow"] != "true")
            {
            <div class="rowborder-top p-2">
                <div class="col-md-12 text-right">
                    <hr />
                    <button type="submit" class="btn btn-blueTwo ms-2 float-end">  Update </button>
                    <a href="@Navigator.LeaveRequest" class="btn btn-sliverOne float-end">Cancel</a>
                </div>
            </div>
        }
    </form>
</div>
