@page
@model SAASShop.Pages.Security.ResetNewPasswordModel

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "User Login";
}

 <h2>New Password</h2><hr />

 <form method="post">

    <div class="form-group">
        <span>Enter New Password</span><span asp-validation-for="NewPassword"></span>
        <input class="form-control" asp-for="NewPassword" type="password" />
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-lg btn-blueOne"> Submit </button>
    </div>

</form>