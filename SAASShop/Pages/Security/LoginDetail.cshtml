@page
@model SAASShop.Pages.Security.LoginDetailModel

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "User Login";
}

<form method="post">

    <div class="form-group">
        <span>Login ID</span> <span asp-validation-for="LoginID"></span>
        <input class="form-control" asp-for="LoginID" type="text" />
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-lg btn-blueOne"> Submit </button>
    </div>

</form>
