@using CommonLib
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <environment names="Development,Test,Uat,Production">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/SAASShopStyle.min.css" />

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
    </environment>

</head>

@{
    @inject SAASShopDataAccess.ISAASShop SAASShopMan
    var SAASShopManProduct = SAASShopMan.GetProductInfo();
}

<body vocab="http://schema.org/" style="background-color:#e5e5e5;">

    <main role="main">
        <div class="container pt-4" style="min-height:500px;">
            <div class="login-panel shadow p-3 container bg-white dataForm" style="max-width:600px;">
                @if (!string.IsNullOrEmpty(SAASShopManProduct.ServerName))
            {
                    <p class="display-6 badge badge-danger p-3">Environment: <strong> @SAASShopManProduct.ServerName</strong></p>
            }
                 @RenderBody()

                  <div asp-validation-summary="All"></div>
            </div>
           
        </div>
    </main>

    <environment names="Development,Test,Uat,Production">
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    </environment>

    <footer class="container mt-4">
        <img src="~/images/Logo.png" class="img-fluid" style="display:block; margin-left:auto; margin-right:auto; max-width:120px" />
        <h4 align="center"><i> Building Beyond Boundaries.</i></h4>

        <p class="text-center lead">@SAASShopManProduct.DisplayName @SAASShopManProduct.Version  ~  from <span style="color:red"><a href="https://kslimon.github.io/" target="_blank">Code In Diary</a> - </span> &copy; @TimeZoneUtility.DateTimeNow.Year - All Rights Reserved.</p>
    </footer>
</body>
</html>
