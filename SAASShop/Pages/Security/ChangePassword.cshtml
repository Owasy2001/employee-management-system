@page
@using SAASShopDomain.User
@model SAASShop.Pages.Security.ChangePasswordModel

@{
    ViewData["Title"] = "Change Password";
}

@section SideMenu {
    @{
        await Html.RenderPartialAsync("_DashboardMenuPartial", new MenuModel { Identifier = "ChangePassword" });
    }
}
        

<h2>Change Password</h2>

<div class="card dataForm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="All"></div>

            <div class="row">
                <div class="col-md-8">
                    <span>Login Id</span><span asp-validation-for="ChangePasswordModelData.LoginID"></span>
                    <input type="text" asp-for="ChangePasswordModelData.LoginID" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-8">
                    <span>Current Password</span><span asp-validation-for="ChangePasswordModelData.Password"></span>
                    <input type="password" asp-for="ChangePasswordModelData.Password" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-8">
                    <span>New Password</span><span asp-validation-for="ChangePasswordModelData.NewPassword"></span>
                    <input type="password" asp-for="ChangePasswordModelData.NewPassword" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-8">
                    <span>Confirm Password</span><span asp-validation-for="ChangePasswordModelData.ConfirmPassword"></span>
                    <input type="password" asp-for="ChangePasswordModelData.ConfirmPassword" class="form-control" />
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-12 text-right">

                    <div class="row border-top p-2">
                        <div class="col">

                            <input type="submit" value="Update" class="btn btn-blueTwo float-right" />
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />