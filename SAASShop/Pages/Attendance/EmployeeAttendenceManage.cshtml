@page
@model SAASShop.Pages.Attendance.EmployeeAttendenceManageModel
@{
    ViewData["Title"] = "Attendance List";
    var today = DateTime.Now;
    var todayDate = DateOnly.FromDateTime(DateTime.Now);
    var previousMonth = today.AddMonths(-1);
}
@section SideMenu
{
    @{
        await Html.RenderPartialAsync("_DashboardMenuPartial", new MenuModel { Identifier = "AttendanceManage" });
    }
}
<partial name="_DataFormTitlePartial" model='new string("Attendance Manage")' />

<form method="post">
    <div class="row">
        <div class="col-md-3">
            <span class="form-label">From</span>
            <input type="date" name="fromDate" class="form-control" value="@previousMonth.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <span class="form-label">To</span>
            <input type="date" name="toDate" class="form-control" value="@today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <div class="mt-4"><input type="submit" value="Search" name="filter" class="btn btn-lm btn-greenOne" /></div>

        </div>
    </div>
</form>

<div class="row">
    <div class="col">

        <table class="table table-striped table-bordered table-hover">
            <thead class="thead-light">
                @if (!Model.checkFilter)
                {
                    <tr>
                        <div class="bg-info text-white p-1" style="text-align:center">
                            <h4>
                                Today(@DateTime.Now.ToString("MMM-dd")) Attendance List
                            </h4>
                            </div>
                    </tr>
                }
                else if (Model.checkFilter)
                {
                    var fromDate = DateTime.Parse(Request.Form["fromDate"]).Date;
                    var toDate = DateTime.Parse(Request.Form["toDate"]).Date;

                    @if (ViewData.ModelState[""]?.Errors.Count > 0)
                    {
                        <div asp-validation-summary="All"></div>
                    }
                    else
                    {
                        <tr>
                            <div class="bg-info text-white p-1" style="text-align:center">
                                <h4>
                                    Attendance List from @fromDate.Date.ToString("dd-MMM") to @toDate.Date.ToString("dd-MMM")
                                </h4>
                            </div>
                        </tr>
                    }
                }
                <tr>
                    <th>Date</th>
                    <th scope="col">Employee ID</th>
                    <th scope="col">Check In</th>
                    <th scope="col">Check Out</th>
                    <th scope="col">Time Spent</th>
                    
                </tr>
            </thead>
            <tbody>
                @if (!Model.checkFilter)
                {
                    if (Model.AttendanceList != null && Model.AttendanceList.Any())
                    {
                        foreach (var attendance in Model.AttendanceList)
                        {
                            if (attendance.Date.Date == today.Date)
                            {
                                <tr>
                                    <td>@attendance.Date.ToString("dd-MMM")</td>
                                    <td>@attendance.AppUserId</td>
                                    <td>@attendance.CheckIn.ToString("hh:mm tt")</td>
                                    <td>@(attendance.CheckOut?.ToString("hh:mm tt") ?? "-")</td>
                                    <td>
                                        @(
                                            attendance.TotalTimeSpent.HasValue
                                            ? Math.Floor((double)(attendance.TotalTimeSpent.Value) * 1000) / 1000
                                            : 0
                                            )
                                    </td>
                                    <td></td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td>@attendance.Date.ToString("dd-MMM")</td>
                                    <td>@attendance.AppUserId</td>
                                    <td>-</td>
                                    <td>-</td>
                                    <td>-</td>
                                </tr>
                            }
                        }
                    }
                }
                else if (Model.checkFilter)
                {
                    var fromDate = DateTime.Parse(Request.Form["fromDate"]);
                    var toDate = DateTime.Parse(Request.Form["toDate"]);
                    if (fromDate < toDate)
                    {
                        foreach (var attendance in Model.FilteredAttendanceManage)
                        {
                            if (attendance != null)
                            {
                                <tr>
                                    <td>@attendance.Date.ToString("dd-MMM")</td>
                                    <td>@attendance.AppUserId</td>
                                    <td>@attendance.CheckIn.ToString("hh:mm tt")</td>
                                    <td>@(attendance.CheckOut?.ToString("hh:mm tt"))</td>
                                    <td>
                                        @(
                                            attendance.TotalTimeSpent.HasValue
                                            ? Math.Floor((double)(attendance.TotalTimeSpent.Value) * 1000) / 1000
                                            : 0
                                            )
                                    </td>
                                    <td></td>
                                </tr>
                            }
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>
