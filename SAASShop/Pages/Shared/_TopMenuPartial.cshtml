@using SAASShopDomain.User
@using Azure.Core
@inject IHttpContextAccessor Accessor

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style type="text/css">
    .menu-top {
        width: 100%;
        max-width: 1320px;
        margin-left: -10px;
        margin-right: -10px;
        margin-bottom: 10px;
        background-color: #269ABC;
    }

  
    .dropdown {
        width: 100%;
        height: 6.5vh;
        position: relative;
        display: inline-block;
    }

    .dropdown-menu {
        display: none;
        right: 0%;
        position: absolute;
        background-color: white;
        min-width: 160px;
        box-shadow: 0px 16px 32px 0px rgba(0,0,0,0.2);
        z-index: 100;
        margin-left: 0.65em;
    }

        .dropdown-menu a {
            color: black;
            padding: 7px 18px;
            text-decoration: none;
            display: block;
        }

            .dropdown-menu a:hover {
                background-color: #ddd;
            }

    .dropdown:hover .dropdown-menu {
        display: block;
    }

    .menu-active {
        background-color: #1c6276;
    }

    .singlMenu-top > ul {
        list-style-type: none;
        margin: 0;
        padding: 0;
        overflow: hidden;
    }

        .singlMenu-top > ul > li {
            float: left !important;
            font-size: 12px;
        }

            .singlMenu-top > ul > li a {
                text-decoration: none;
                display: block;
                color: white;
                height:30px;
                width: 100%;
                font-size: 14px;
                padding: 1px 50px;
                border-right: 2px solid #43a5c3;
            }

                .singlMenu-top > ul > li a:hover {
                    background-color: #1c6276;
                    color: white;
                    text-decoration: none;
                }

    .button-container {
        display: flex;
        margin-right: 10px;
    }

        .button-container li {
            margin-left: 10px;
        }

    .tooltip-container {
        visibility: hidden;
        color: black;
        text-align: center;
        border-radius: 6px;
        padding: 5px 0;
        background-color: #269ABC;
    }

    .menu-top2 {
        width: 100%;
        max-width: 1320px;
        margin-left: -10px;
        margin-right: -10px;
        margin-bottom: 10px;
        background-color: #269ABC;
    }


    .tooltip-container span {
        font-size: 10px;
        background-color: #3498db;
        color: white;
        padding: 5px 5px;
        border: none;
        border-radius: 5px;
        outline: none;
    }


    .singlMenu-top2 > ul > li a:hover + .tooltip-container .tooltiptext {
        visibility: visible;
    }

    .singlMenu-top2 > ul > li {
        height: 15px;
    }

    .moduleTitleColor {
        background-color: #3B4298;
        font-weight: bold;
        border-right: none;
        color: white;
    }

    .button-container a{
        text-decoration:none
    }



</style>


@{
    var environment = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT");
}

@{
    int appUserId = int.Parse(User.Claims.FirstOrDefault(s => s.Type == "UserId").Value);   
    var lastActiveOn = Accessor.HttpContext.Session.GetString("LastActiveOn");
}

<div style="background-color:#252525; margin-left: -16px; margin-right: -2px;">

    <div class="singlMenu-top2 d-flex justify-content-between border-bottom pt-1" style="z-index: 2;">
        <ul style="color:white; list-style: none; justify-content: flex-start; margin: 0; margin-right: -15px;">
            <li >
                <a asp-page="@Navigator.UserProfile" style="color:white; text-decoration: none;"><i class="bi bi bi-person" style="font-size: 15px;color:  #fff;"></i>
                <Strong> @User.Claims.FirstOrDefault(s => s.Type == System.Security.Claims.ClaimTypes.GivenName).Value</strong></a>
                Logged On: @DateTime.Parse(lastActiveOn).ToString("MMM-dd-yyyy hh:mm tt")
                <div class="tooltip-container"> <span class="tooltiptext">My Profile</span> </div>
            </li>
        </ul>

        <ul class="button-container d-flex" style="max-width: 1500px; margin-left: 100px; margin-right: 10px; z-index: 5; color: white; padding-left: 0; list-style: none; justify-content: flex-end;">
         
            
            @* <li class="mt-2" >
                <a asp-page="@Navigator.ChatSystem"><i class="bi bi-chat-left-text-fill" style=" font-size: 25px;color: white;"></i></a>
                <div class="tooltip-container"> <span class="tooltiptext">Chat</span> </div>
            </li> 
             <li class="mt-1" >
                <a id="openPopupBtn"><i class="bi bi-envelope-fill" style=" font-size: 25px;color: white;"></i></a>
                <div class="tooltip-container"> <span class="tooltiptext">Email</span> </div>
            </li> *@
        
            <li>
                <div class="dropdown mt-2" >
                      <a role="button" data-bs-toggle="dropdown"   >
                      <img src="~/images/Logo.png" class="img-fluid" style="width:50px; height: 50px; border-radius: 50%; border:solid 1px white"  />
                      </a>
                      <ul class="dropdown-menu" style="z-index:7;" >
                        <li><a class="dropdown-item" asp-page="@Navigator.Login" asp-page-handler="LogOff"><i class="bi bi-box-arrow-right" style="font-size: 15px;color:  #3B4298;"></i>Log off</a></li>
                        <li><a class="dropdown-item" asp-page="@Navigator.UserProfile" asp-page-handler="Profile"><i class="bi bi-person" style="font-size: 15px;color:  #3B4298;"></i>My Profile</a></li>
                        @* <li><a class="dropdown-item" id="TechSupport"><i class="bi bi-lightning" style="font-size: 15px;color:  #3B4298; cursor:pointer"></i>  Tech Email</a></li> *@
                        @* <li><a class="dropdown-item" asp-page="@Navigator.Tasks" asp-page-handler="LogOff"><i class="bi bi-list-task" style="font-size: 15px;color:  #3B4298;"></i>  My Tasks</a></li> *@
                      </ul>
                </div>

            </li>
     
        </ul>
    </div>
</div>

<div style="margin-left: -16px; margin-right:-2px;">
    <div class="singlMenu-top border-bottom bg-info bg-gradient" style="z-index:1; ">
        <ul style="max-width:1200px; margin-left:auto; margin-right:auto;z-index:1;">
            <li><a href="@Navigator.Dashboard"> Dashboard</a></li>
            @* <li><a href="@Navigator.Search">Search</a></li> *@
        </ul>
    </div>
</div>


