@model SAASShop.Pages.CommitCancelModel

<div class="row border-top p-2">
    <div class="col">
        <input type="submit" value="Save & Add New" asp-page-handler="SaveAndNew" class="btn btn-blueOne float-right" />
        <input type="submit" value="Save" class="btn btn-blueTwo float-right mr-2" id="SaveBtn" />
        <a href="@Model.CancelUrl" class="btn btn-sliverOne float-right mr-2">Cancel</a>
        <div>
            <strong class="px-2 py-1 btn-blueTwo float-right mr-2" id="SaveMsg" style="display:none">Saving... Please Wait.</strong>
        </div>
    </div>
</div>

<input type="hidden" asp-for="CancelUrl" />

<script src="~/js/ButtonControl.js"></script>