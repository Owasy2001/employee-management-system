<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - CodeInDiary</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">

    <environment names="Development,Test,Uat,Production">

        <!-- CSS Files -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.kendostatic.com/themes/7.2.1/bootstrap/bootstrap-main.css" />

        <link rel="stylesheet" href="~/css/SAASShopStyle.min.css" />

        <!-- JS Files -->
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>

        <script src="~/js/site.js"></script>

        <script src="~/js/USign.js"></script>


    </environment>
</head>

<body vocab="http://schema.org/" style="background-color:#efefef;">

    <div class="container-fluid">
        <main role="main">
            <div class="leftmenu" id="MenuLeftSide">
                @RenderSection("SideMenu", required: false)
            </div>
            <div class="rightcontent  pl-4 pr-4 pb-4" style="min-height:600px;" id="mainContent">

                @{
                    <partial name="_TopMenuPartial"/>
                }
                @RenderBody()
            </div>
        </main>
    </div>

    @RenderSection("scripts", required: false)

    <!-- Add Blazor server-side script just before closing body tag -->
    <script src="_framework/blazor.server.js"></script>
</body>

</html>