@page "{Id}"
@model SAASShop.Pages.Admin.EditAppUserModel
@{
    ViewData["Title"] = "Edit App User";
}

@section SideMenu {
    @{
        await Html.RenderPartialAsync("_DashboardMenuPartial", new MenuModel { Identifier = "manageuser" });
    }
}

@if (HttpContext.Request.Query["IsDelete"] == "true")
{
    <form method="Post" asp-page-handler="Delete">

        <input type="hidden" name="listId" value="@Model.AppUserData.Id" />

        <partial name="_DeletePartial" model="new DeleteCancelModel { ListId = Model.AppUserData.Id, CancelUrl = Navigator.ManageUser }" view-data="ViewData" />
    </form>
}

<partial name="_DataFormTitlePartial" model='new string("Edit App Users")' />

<div class="card dataForm">
        <form method="Post">

            <partial name="_AppUserPartial" model="Model.AppUserData" />
            @if (HttpContext.Request.Query["IsDelete"] != "true")
            {
                <div class="rowborder-top p-2">
                    <div class="col-md-12 text-right">
                        <hr />
                        <button type="submit" class="btn btn-blueTwo ms-2 float-end">  Update </button>
                        <a href="@Navigator.ManageUser" class="btn btn-sliverOne float-end">Cancel</a>
                    </div>
                </div>
            }
        </form>
</div>
