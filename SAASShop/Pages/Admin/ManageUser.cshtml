@page
@model ManageUserModel

@{
    ViewData["Title"] = "Add New User";    
}

@section SideMenu {
    @{
        await Html.RenderPartialAsync("_DashboardMenuPartial", new MenuModel { Identifier = "manageuser" });
    }
}

@if (TempData["Message"] != null)
{
    <partial name="_MessagePartial" model='new MessageModel { Message = TempData["Message"] }' />
}

<partial name="_DataFormTitlePartial" model='new string("App Users")' />

<div class="card">

<div class="mt-2">
        <a href="@Navigator.AddAppUser" class="btn btn-sm btn-greenOne">Add New</a>
</div>


<div class="row">
    <div class="col">
        <table class="table table-striped table-bordered table-hover">
            <thead class="thead-light">
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Phone</th>
                    <th scope="col">Department</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
            
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.Phone</td>

                        <td>@user.Role</td>
                        
                        <td>
                                <a href="@Navigator.EditAppUser/@user.Id" class="btn btn-xs btn-greenTwo">Edit</a>
                                <a href="@Navigator.EditAppUser/@user.Id?IsDelete=true" class="btn btn-xs btn-redOne">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
</div>

