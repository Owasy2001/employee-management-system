@page
@using SAASShopDomain;
@model SAASShop.Pages.Admin.AddAppUserModel

@{
    ViewData["Title"] = "Add New User";
}

@section SideMenu {
    @{
        await Html.RenderPartialAsync("_DashboardMenuPartial", new MenuModel { Identifier = "manageuser" });
    }
}

<partial name="_DataFormTitlePartial" model='new string("Add App Users")' />

<div class="card dataForm">
    <div class="card-body">
        <form method="Post">
            <partial name="_AppUserPartial" model="Model.AppUserData" />
            
            <div class="rowborder-top p-2">
                <div class="col-md-12 text-right">
                    <hr />
                    <button type="submit" class="btn btn-blueTwo ms-2 float-end">  Save </button>
                    <a href="@Navigator.ManageUser" class="btn btn-sliverOne float-end">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>