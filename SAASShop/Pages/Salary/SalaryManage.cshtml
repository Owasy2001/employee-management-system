@page
@model SAASShop.Pages.Salary.SalaryManageModel
@{
    ViewData["Title"] = "Salary Manage";
    //var pageHeader = "Add New User";

}
@section SideMenu {
    @{
        await Html.RenderPartialAsync("_DashboardMenuPartial", new MenuModel { Identifier = "salary" });
    }
}
@if (TempData["Message"] != null)
{
    <partial name="_MessagePartial" model='new MessageModel { Message = TempData["Message"] }' />
}
<partial name="_DataFormTitlePartial" model='new string("Salary Management")' />

<div class="card">

    <div class="mt-2">
        <a href="@Navigator.PayRoll" class="btn btn-sm btn-greenOne">Add New</a>
    </div>

<div class="row">
    <div class="col">
        <table class="table table-striped table-bordered table-hover">
            <thead class="thead-light">
             <tr>
                <th scope="col">Name</th>
                <th scope="col">Email</th>
                <th scope="col">Department</th>
                <th scope="col">NetSalary</th>
                <th scope="col">Date</th>
                <th scope="col">Action</th>
              </tr>
            </thead>
        <tbody>


                @foreach (var user in Model.Userpayroll)

            {
               
               
                <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.Role</td>
                     <td>
                        @if (user != null)
                        {
                            @user.NetSalary
                        }
                    </td>
                    <td>
                        @if (user != null)
                        {
                            @user.PayDate
                        }
                    </td>

                    <td>
                            
                                <a href="@Navigator.EditPayRoll/@user.Id" class="btn btn-xs btn-greenTwo">Edit</a>
                                <a href="@Navigator.EditPayRoll/@user.Id?IsDelete=true" class="btn btn-xs btn-redOne">Delete</a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>
</div>
